{
  "name": "@varyo/api",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "bun run dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "prisma": "prisma",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate || exit 0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7",
    "better-auth": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^18.0.2",
    "express": "^5.2.1",
    "googleapis": "^181.0.0",
    "pg": "^8.23.0",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
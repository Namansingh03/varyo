{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "strict": true,
    "skipLibCheck": true,

    "declaration": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "noEmit": true
  },
  "include": [
    "src/**/*.ts"
  ]
}